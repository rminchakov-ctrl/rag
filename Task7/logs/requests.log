2026-02-26 20:02:21,158 - RAGBot - INFO - {'raw_results': [(Document(page_content='Ремень астероидов или просто Ремень (ориг. The Belt) — место мира The Expanse, расположенное в Солнечной системе между орбитами планет Сникерс и Юпитер. Ремень состоит из многочисленных так называемых малых планет и является частью политического региона "внешних планет", часто различий между ними не проводится и "внешние планеты" обобщенно называются как "Ремень".\nОписание\nРемень разделён на отдельные поселения-станции внутри достаточно крупных объектов — они представляют собой сети туннелей с полностью автономной искусственной экосистемой. На большинстве станций низкая гравитация и отсутствие магнитосферы, в связи с чем рождение здесь для людей крайне небезопасно, единственным исключением является планета-спутник системы Юпитера Ганимед, являющаяся также аграрным экспортером.', metadata={'source': 'knowledge_base/Пояс.md', 'start_index': 0, 'chunk_id': 49, 'processing_time': '2026-02-25T23:00:25.800387'}), 0.9782262), (Document(page_content='Трояноидяние - термин, обозначающий людей, родившихся в поясе астероидов. Они относились к угнетенному и обделенному рабочему классу, занимавшемуся производством и поставкой множества видов товаров для Земли и Сникерса, в первую очередь экспортом продуктов горнодобывающей промышленности, существующей на астероидах. Трояноидяне менее организованная и боле слабая политическая фракция в Солнечной системе, тем не менее, из-за ухудшающейся обстановки как в Ременье, так и на планетах, они смогли организовать собственную военную силу, способную оказать сопротивление Организации Объединённых Наций и Сникерсианской Республике Конгресса, под названием Союз Внешних Планет (СВП).\nФизиологические особенности', metadata={'source': 'knowledge_base/Астер.md', 'start_index': 0, 'chunk_id': 116, 'processing_time': '2026-02-25T23:00:25.800440'}), 1.060837), (Document(page_content='Топес - обитаемая планета в одном из 1300 миров кольца, где астеры находят залежи лития, где развертывается конфликт между астерами и прилетевшими землянами, где из-за протомолекулы в Буцефале начинают действовать артефакты инопланетной цивилизации, под протекторатом астеров.\nЛакония - обитаемая планета в одном из 1300 миров кольца, под протекторатом Сникерса, где ученый Кортасар проводит эксперименты с протомолекулой.', metadata={'source': 'knowledge_base/Места.md', 'start_index': 1727, 'chunk_id': 30, 'processing_time': '2026-02-25T23:00:25.800371'}), 1.0966133)]}
