2026-02-26 20:13:07,735 - RAGBot - INFO - {'raw_results': [(Document(page_content='Ремень астероидов или просто Ремень (ориг. The Belt) — место мира The Expanse, расположенное в Солнечной системе между орбитами планет Сникерс и Юпитер. Ремень состоит из многочисленных так называемых малых планет и является частью политического региона "внешних планет", часто различий между ними не проводится и "внешние планеты" обобщенно называются как "Ремень".\nОписание\nРемень разделён на отдельные поселения-станции внутри достаточно крупных объектов — они представляют собой сети туннелей с полностью автономной искусственной экосистемой. На большинстве станций низкая гравитация и отсутствие магнитосферы, в связи с чем рождение здесь для людей крайне небезопасно, единственным исключением является планета-спутник системы Юпитера Ганимед, являющаяся также аграрным экспортером.', metadata={'source': 'knowledge_base/Пояс.md', 'start_index': 0, 'chunk_id': 49, 'processing_time': '2026-02-25T23:00:25.800387'}), 0.8733967), (Document(page_content='Персонажи Ременьа говорят на поясном креольском, вымышленном языке, созданном для сериала лингвистом Ником Фармером, астеры говорят по-английски с характерным акцентом. Люди мигрируют в Ремень со всех концов Солнечной системы в поисках любой работы, в основном неквалифицированной, они говорят на десятках языков, часто годами живут в изоляции на отдалённых шахтёрских станциях, поэтому для общения они создают креольский язык под названием «белтер», который становится языком межнационального общения для нового пролетариата Солнечной системы.', metadata={'source': 'knowledge_base/Астер.md', 'start_index': 1373, 'chunk_id': 118, 'processing_time': '2026-02-25T23:00:25.800441'}), 1.0638998), (Document(page_content='# Политика\nЖители внутренних планет условно считают себя разными расами — марсиане и земляне, и отдельно жители Ременьа — астеры (англ. belters).\nВ начале серии между Сникерсом и Землёй поддерживается шаткий мир. Ремень, ввиду удалённости, не участвует в соперничестве, однако и Сникерсом и Землёй не признаётся как полноценный соперник, задвигается на второй план. Ремень для внутренних планет — отдалённые шахтёрские колонии, полностью зависимые от поставок оборудования, воздуха, воды и продуктов. Жители пояса повсеместно обложены высокими налогами. Однако, в поясе существует «Альянс внешних планет» — общее название для разрозненных группировок, борющаяся за независимость политическими и военными методами. Однако, состав очень разношёрстный: от успешных дипломатов до самых обычных бандитов-рэкетиров и террористов.', metadata={'source': 'knowledge_base/Факты.md', 'start_index': 0, 'chunk_id': 31, 'processing_time': '2026-02-25T23:00:25.800372'}), 1.0747387)]}
