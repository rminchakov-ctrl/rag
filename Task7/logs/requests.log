2026-02-26 20:02:15,644 - RAGBot - INFO - {'raw_results': [(Document(page_content='Известные корабли\nНазвание\tКласс\tФракция\tПримечания\nОлоло/Бегемот/Станция Медина\tКорабль поколений/Линкор-Бегемот/Станция\tСтанция «Громко»/АВП Андерсона Доуза/Флот АВП\t\nБуцефал\tКорвет\tКоманда Шеридана\tНеоднократно действовал по контракту с АВП.\nМечта Каллисто\tТяжелый грузовой корабль\tСтанция «Громко»\tСнабжал станцию Медина.\nСкопули\tТранспортный корабль\tАВП Андерсона Доуза\tЗахвачен Протогеном и использован в качестве приманки для уничтожения Ведьма.\nГай Молинари\tТранспортный корабль\tСтанция «Громко»\t\nТэлбот Лидс\tТранспортный корабль\tСтанция «Громко»\tОтправил команды для установки ядерного оружия на поверхность зараженного Сорэа.\nПлачущий Лунатик\tТранспортный корабль\tСтанция «Громко»\tДоставлял провизию на Ганимед во время кризиса.', metadata={'source': 'knowledge_base/СВП.md', 'start_index': 4372, 'chunk_id': 126, 'processing_time': '2026-02-25T23:00:25.800447'}), 1.166206), (Document(page_content='Дизайн «небоскреба»: В отличие от кораблей из других франшиз, «Роси» внутри выглядит как вертикальное здание. Палубы расположены слоями от двигателя вверх: реактор, машинное отделение, жилые палубы, госпиталь и, на самом верху, — командный мостик.\nВооружение: Корабль оснащен точечными оборонительными орудиями (PDC) для уничтожения ракет, торпедными аппаратами и, позже, установленным рельсотроном (Railgun).\nВнешний вид: Герой книг Праксидик Менг описывал «Роси» как «гигантское долото с перевернутой кофейной чашкой сзади». \nЗнаковые моменты биографии\nЛегализация: Долгое время корабль считался украденным имуществом Сникерса. После помощи в разрешении кризиса на Сорэе и Ганимеде, Сникерсианская Республика официально передала права на судно Шеридану в качестве оплаты за услуги (и чтобы избежать дипломатического скандала).', metadata={'source': 'knowledge_base/Роси.md', 'start_index': 3642, 'chunk_id': 89, 'processing_time': '2026-02-25T23:00:25.800420'}), 1.2028687), (Document(page_content='Томас Принс - земной корабль, отправляющийся к Кольцу для его исследования\nСюэсень - марсианский корабль, отправляющийся к Кольцу для его исследования\nСенг Ун - земной грузовой корабль, на котором Мельпомена Коул закладывает взрывчатку, чтобы подставить Зака Шеридана из мести за отца\nБаркит - марсианский боевой корабль, при прохождении кольца судно уничтожают инопланетные сущности.\nЛазурный дракон - корабль-наводчик, управляет заряженными астероидами, сбрасывает их на Землю по приказу Марко Инароса.\nПелла - боевой корабль Марко Инароса, при прохождении кольца судно уничтожают инопланетные сущности.\nНагата - шаттл, на котором Филип улетает с Пеллы и которому дает имя матери.', metadata={'source': 'knowledge_base/Корабли.md', 'start_index': 2531, 'chunk_id': 48, 'processing_time': '2026-02-25T23:00:25.800386'}), 1.207361)]}
